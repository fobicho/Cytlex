VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional public AniList client ID for local development.
# Register a separate AniList app with Redirect URL http://localhost:5174/.
# Production uses VITE_ANILIST_CLIENT_ID or the built-in Cytlex client ID.
# VITE_ANILIST_LOCAL_CLIENT_ID=

# Public browser app ID from Comick Developers. Never put a client secret here.
VITE_COMICK_CLIENT_ID=
# Optional. By default Cytlex uses the current origin with `/` as the OAuth callback.
# VITE_COMICK_REDIRECT_URI=https://cytlex.dev/
